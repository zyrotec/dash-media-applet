{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "sourceMap": false,
    "types": [
      "@girs/gjs",
      "@girs/gnome-shell",
      "@girs/st-17"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}